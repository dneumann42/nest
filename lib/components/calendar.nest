component dateSelector key target:
  define:
    keyText = (eval key)
    selected = (eval target)
    year = (date-year selected)
    month = (date-month selected)
    firstWeekday = (date-first-weekday year month)
    days = (date-days-in-month year month)
    cellDay = (- 1 firstWeekday)
    previousID = (id keyText "previous-month")
    nextID = (id keyText "next-month")

  events:
    when (clicked previousID):
      set (value-of target) (date-add-months selected -1)
    when (clicked nextID):
      set (value-of target) (date-add-months selected 1)

  card (id keyText "calendar"):
    width = fill
    height = fit
    padding = 8
    gap = 6
    alignItems = AlignStretch
    row (id keyText "calendar-header"):
      width = fill
      height = fit
      gap = 6
      alignItems = AlignCenter
      button previousID "<":
        width = (fixed 28)
        height = fit
      label (id keyText "calendar-title") (date-month-title year month):
        width = fill
        height = fit
      button nextID ">":
        width = (fixed 28)
        height = fit
    row (id keyText "calendar-weekdays"):
      width = fill
      height = fit
      gap = 4
      label (id keyText "weekday" 0) "Su":
        width = (fixed 34)
        height = fit
      label (id keyText "weekday" 1) "Mo":
        width = (fixed 34)
        height = fit
      label (id keyText "weekday" 2) "Tu":
        width = (fixed 34)
        height = fit
      label (id keyText "weekday" 3) "We":
        width = (fixed 34)
        height = fit
      label (id keyText "weekday" 4) "Th":
        width = (fixed 34)
        height = fit
      label (id keyText "weekday" 5) "Fr":
        width = (fixed 34)
        height = fit
      label (id keyText "weekday" 6) "Sa":
        width = (fixed 34)
        height = fit
    for week (range 0 6):
      row (id keyText "week" week):
        width = fill
        height = fit
        gap = 4
        for weekday (range 0 7):
          if (and (>= cellDay 1) (<= cellDay days)):
            then:
              define:
                dayID = (id keyText "day" cellDay)
                cellDate = (date year month cellDay)
              events:
                when (clicked dayID):
                  set (value-of target) cellDate
              button dayID cellDay:
                width = (fixed 34)
                height = fit
            else:
              spacer (id keyText "blank" week weekday):
                width = (fixed 34)
                height = (fixed 24)
          += cellDay 1
    label (id keyText "selected-date") selected:
      width = fill
      height = fit

component dateSelectorWithSignal key target clickedTarget:
  define:
    keyText = (eval key)
    selected = (eval target)
    year = (date-year selected)
    month = (date-month selected)
    firstWeekday = (date-first-weekday year month)
    days = (date-days-in-month year month)
    cellDay = (- 1 firstWeekday)
    previousID = (id keyText "previous-month")
    nextID = (id keyText "next-month")

  events:
    when (clicked previousID):
      set (value-of target) (date-add-months selected -1)
    when (clicked nextID):
      set (value-of target) (date-add-months selected 1)

  card (id keyText "calendar"):
    width = fill
    height = fit
    padding = 8
    gap = 6
    alignItems = AlignStretch
    row (id keyText "calendar-header"):
      width = fill
      height = fit
      gap = 6
      alignItems = AlignCenter
      button previousID "<":
        width = (fixed 28)
        height = fit
      label (id keyText "calendar-title") (date-month-title year month):
        width = fill
        height = fit
      button nextID ">":
        width = (fixed 28)
        height = fit
    row (id keyText "calendar-weekdays"):
      width = fill
      height = fit
      gap = 4
      label (id keyText "weekday" 0) "Su":
        width = (fixed 34)
        height = fit
      label (id keyText "weekday" 1) "Mo":
        width = (fixed 34)
        height = fit
      label (id keyText "weekday" 2) "Tu":
        width = (fixed 34)
        height = fit
      label (id keyText "weekday" 3) "We":
        width = (fixed 34)
        height = fit
      label (id keyText "weekday" 4) "Th":
        width = (fixed 34)
        height = fit
      label (id keyText "weekday" 5) "Fr":
        width = (fixed 34)
        height = fit
      label (id keyText "weekday" 6) "Sa":
        width = (fixed 34)
        height = fit
    for week (range 0 6):
      row (id keyText "week" week):
        width = fill
        height = fit
        gap = 4
        for weekday (range 0 7):
          if (and (>= cellDay 1) (<= cellDay days)):
            then:
              define:
                dayID = (id keyText "day" cellDay)
                cellDate = (date year month cellDay)
              events:
                when (clicked dayID):
                  set (value-of target) cellDate
                  set (value-of clickedTarget) cellDate
              button dayID cellDay:
                width = (fixed 34)
                height = fit
            else:
              spacer (id keyText "blank" week weekday):
                width = (fixed 34)
                height = (fixed 24)
          += cellDay 1
    label (id keyText "selected-date") selected:
      width = fill
      height = fit
