import "pathEditorActions.nest"
define:
  newButton (id)
  browseButton (id)
  saveButton (id)
  execStatusID (id)
  pathListBoxID (id)
  pathOutput "pathEditor.paths"
  paths (split (env "PATH") ":")
  defaultGap 8.0
  searchID (id)
  search (LineInputState "")
  newPathID (id)
  newPath (LineInputState "")
  pathLineEdit (EditLineState)
events:
  when (clicked newButton):
    addPath newPath
  when (clicked browseButton):
    browseFolder newPath
  when (clicked saveButton):
    savePaths
    exec "printf 'saved paths to pathEditor.paths\n'"
column (id):
  width = (fill)
  height = (fill)
  gap = defaultGap
  padding = 16.0
  alignItems = AlignCenter
  row (id):
    width = (fill)
    height = (fit)
    gap = defaultGap
    alignItems = AlignCenter
    label (id) "Path Editor":
      width = (fill)
      height = (fit)
    button saveButton "Save":
      width = (fit)
      height = (fit)
  row (id):
    width = (prefer 800: min = 400)
    height = (fit)
    gap = defaultGap
    alignItems = AlignCenter
    label (id) "Search":
      width = (fit)
      height = (fit)
    lineInput searchID search:
      width = (fill)
      height = (fit)
  execStatus execStatusID
  pathListBox pathListBoxID paths pathLineEdit search
  row (id):
    width = (prefer 800: min = 400)
    height = (fit)
    gap = defaultGap
    lineInput newPathID newPath:
      width = (fill)
      height = (fit)
    button browseButton "Browse":
      width = (fit)
      height = (fit)
    button newButton "New":
      width = (fit)
      height = (fit)
