define:
  startID = (id "start")
  lastAction = ""

fun startMenu lbl:  
  button startID lbl:
    width = fit
    height = fit

fun defaultConfig:
  {}:
    start-label = "Alatar"

define:
  cfg = defaultConfig

events:
  when (clicked startID):
    when (not (dialogOpen? "start")):
      openDialog "start" "./startPopover" (dict-get cfg "start-label")
  when (not (= (dialogResult "start") nothing)):
    set lastAction (dialogResult "start")
    clearDialogResult "start"

column (id "root"):
  width = fill
  height = fill
  alignItems = AlignStretch
  panel (id "bar"):
    width = fill
    height = (fixed 36)
    padding = 6
    alignItems = AlignStretch
    row (id "content"):
      width = fill
      height = fill
      gap = 12
      alignItems = AlignCenter
      row (id "left"):
        width = (fixed 280)
        height = fit
        gap = 8
        alignItems = AlignCenter
        startMenu (dict-get cfg "start-label")
        label (id "workspace") "1":
          width = (fixed 24)
          height = fit

      row (id "center"):
        width = fill
        height = fit
        alignItems = AlignCenter
        justifyContent = JustifyCenter
        label (id "clock") (clock "ddd HH:mm"):
          width = fit
          height = fit
      row (id "right"):
        width = (fixed 280)
        height = fit
        gap = 10
        alignItems = AlignCenter
        justifyContent = JustifyEnd
        label (id "network") "NET":
          width = fit
          height = fit
        label (id "volume") "VOL 72%":
          width = fit
          height = fit
        label (id "battery") "BAT 86%":
          width = fit
          height = fit
