define:
  startID = (id "start")
  clockID = (id "clock")
  lastAction = ""

fun startMenu lbl:  
  imageButton startID "example/layerShellBar/assets/nomicon-small.bmp":
    width = fixed 28
    height = fixed 28

fun dateTime:
  button clockID (clock "MMM d, yyyy   hh:mm:ss tt"):
    width = fit
    height = fit

fun defaultConfig:
  {}:
    start-label = "Alatar"

define:
  cfg = defaultConfig

import "components/workspaces.nest"
import "components/activeWindow.nest"
import "components/volume.nest"
import "components/metrics.nest"
import "components/notifications.nest"

events:
  when (and (clicked startID) (not (dialogOpen? "start"))):
    openDialog "start" "./startPopover" (dict-get cfg "start-label")
  when (and (clicked clockID) (not (dialogOpen? "clock"))):
    openDialog "clock" "./clock" ""
  when (not (= (dialogResult "start") nothing)):
    set lastAction (dialogResult "start")
    clearDialogResult "start"
  when (= lastAction "logout"):
    closeDialog "logout"

column (id "root"):
  width = fill
  height = fill
  alignItems = AlignStretch
  panel (id "bar"):
    width = fill
    height = fixed 36
    padding = 6
    alignItems = AlignStretch
    overlay (id "content"):
      width = fill
      height = fill
      alignItems = AlignCenter
      row (id "bar-row"):
        width = fill
        height = fill
        gap = 14
        alignItems = AlignCenter
        alignSelf = AlignStretch
        row (id "left"):
          width = fill
          height = fit
          gap = 14
          alignItems = AlignCenter
          startMenu (dict-get cfg "start-label")
          workspaces "bar"
          activeWindow "bar"
        spacer (id "clock-reserve"):
          width = fixed 260
          height = fit
        row (id "right"):
          width = fill
          height = fit
          gap = 14
          alignItems = AlignCenter
          justifyContent = JustifyEnd
          volumeWidget "bar"
          cpuMeter "bar"
          memoryMeter "bar"
          storageMeter "bar"
          notificationWidget "bar"
          networkMeter "bar"
      row (id "clock-center"):
        width = fill
        height = fill
        alignItems = AlignCenter
        justifyContent = JustifyCenter
        alignSelf = AlignStretch
        dateTime
