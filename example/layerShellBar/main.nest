define:
  startID = (id "start")
  clockID = (id "clock")
  lastAction = ""

fun startMenu lbl:  
  button startID lbl:
    width = fit
    height = fit

fun dateTime:
  button clockID (clock "MMM d, yyyy   hh:mm:ss tt"):
    width = fit
    height = fit

fun defaultConfig:
  {}:
    start-label = "Alatar"

define:
  cfg = defaultConfig

events:
  when (and (clicked startID) (not (dialogOpen? "start"))):
    openDialog "start" "./startPopover" (dict-get cfg "start-label")
  when (and (clicked clockID) (not (dialogOpen? "clock"))):
    openDialog "clock" "./clock" ""
  when (not (= (dialogResult "start") nothing)):
    set lastAction (dialogResult "start")
    clearDialogResult "start"
  print (dialogResult "clock")

column (id "root"):
  width = fill
  height = fill
  alignItems = AlignStretch
  panel (id "bar"):
    width = fill
    height = (fixed 36)
    padding = 6
    alignItems = AlignStretch
    row (id "content"):
      width = fill
      height = fill
      gap = 12
      alignItems = AlignCenter
      row (id "left"):
        width = (fixed 280)
        height = fit
        gap = 8
        alignItems = AlignCenter
        startMenu (dict-get cfg "start-label")
        label (id "workspace") "1":
          width = (fixed 24)
          height = fit
      row (id "center"):
        width = fill
        height = fit
        alignItems = AlignCenter
        justifyContent = JustifyCenter
	dateTime
      row (id "right"):
        width = (fixed 280)
        height = fit
        gap = 10
        alignItems = AlignCenter
        justifyContent = JustifyEnd
        label (id "network") "NET":
          width = fit
          height = fit
        label (id "volume") "VOL 72%":
          width = fit
          height = fit
        label (id "battery") "BAT 86%":
          width = fit
          height = fit
