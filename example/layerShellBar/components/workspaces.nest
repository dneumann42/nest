fun workspaceLabel workspace:
  define:
    name = (dict-get workspace "name")
  cond:
    when (dict-get workspace "urgent"):
      string "! " name
    when (dict-get workspace "focused"):
      string "[" name "]"
    when T:
      name

fun workspaceBackgroundColor workspace:      
  cond:
    when (dict-get workspace "urgent"):
      (color 118 70 20)
    when (dict-get workspace "focused"):
      mix-color (theme-color "primary") (color 18 20 20) 0.4
    when T:
      (color 20 20 20)

fun workspaceQuery key:
  swayWorkspaceSubscription key

component workspaces key:
  define:
    keyText = (eval key)
    workspaceList = (workspaceQuery (id keyText "query"))

  row (id keyText "workspaces"):
    width = fit
    height = fit
    gap = 1
    alignItems = AlignCenter
    if (empty? workspaceList):
      then:
        label (id keyText "empty") "-":
          width = (fixed 24)
          height = fit
      else:
        for workspace (iter workspaceList):
          define:
            name = (dict-get workspace "name")
            workspaceID = (id keyText "workspace" name)
          events:
            when (clicked workspaceID):
              shellAsync (id keyText "activate" name) (swayWorkspaceCommand name) 0
          button workspaceID (workspaceLabel workspace):
            width = fit
            height = fit
	    background = (workspaceBackgroundColor workspace)

