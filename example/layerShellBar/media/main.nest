import "../components/media.nest"

define:
  artworkID = (id "media" "artwork")
  previousID = (id "media" "previous")
  playPauseID = (id "media" "play-pause")
  nextID = (id "media" "next")
  title = ""
  artist = ""
  album = ""
  status = ""
  statusOverride = ""
  displayStatus = ""
  player = ""
  length = ""
  url = ""
  art = ""
  playPauseLabel = "Play"

set title (mediaQuery (id "media" "query" "title") "metadata --format '{{title}}' 2>/dev/null || printf 'No media'")
set artist (mediaQuery (id "media" "query" "artist") "metadata --format '{{artist}}' 2>/dev/null || true")
set album (mediaQuery (id "media" "query" "album") "metadata --format '{{album}}' 2>/dev/null || true")
set status (mediaQuery (id "media" "query" "status") "status 2>/dev/null || printf 'Stopped'")
set player (mediaQuery (id "media" "query" "player") "metadata --format '{{playerName}}' 2>/dev/null || true")
set length (mediaQuery (id "media" "query" "length") "metadata --format '{{mpris:length}}' 2>/dev/null || true")
set url (mediaQuery (id "media" "query" "url") "metadata --format '{{xesam:url}}' 2>/dev/null || true")
set art (mediaArtwork (id "media" "query" "art"))
when (= status statusOverride):
  set statusOverride ""
set displayStatus (pick (= statusOverride "") status statusOverride)
set playPauseLabel (pick (= displayStatus "Playing") "Pause" "Play")

redrawAfter 2000

events:
  when (keyPressed "escape"):
    closeDialog ""
  when (clicked artworkID):
    closeDialog ""
  when (clicked previousID):
    mediaAction (id "media" "action" "previous") "previous 2>/dev/null"
  when (clicked playPauseID):
    set statusOverride (pick (= displayStatus "Playing") "Paused" "Playing")
    set displayStatus statusOverride
    set playPauseLabel (pick (= displayStatus "Playing") "Pause" "Play")
    mediaAction (id "media" "action" "play-pause") "play-pause 2>/dev/null"
  when (clicked nextID):
    mediaAction (id "media" "action" "next") "next 2>/dev/null"

card (id "media" "dialog"):
  width = fill
  height = fill
  padding = 64
  gap = 12
  alignItems = AlignStretch
  row (id "media" "body"):
    width = fill
    height = fill
    gap = 14
    alignItems = AlignStretch
    column (id "media" "left"):
      width = (fixed 250)
      height = fill
      gap = 10
      alignItems = AlignStretch
      imageButton artworkID art:
        width = fill
        height = (fixed 250)
      label (id "media" "title") title:
        width = fill
        height = fit
        textScroll = true
      label (id "media" "artist") artist:
        width = fill
        height = fit
        textScroll = true
      row (id "media" "controls"):
        width = fill
        height = fit
        gap = 10
        justifyContent = JustifyCenter
        button previousID "Previous":
          width = (fixed 104)
          height = (fixed 36)
        button playPauseID playPauseLabel:
          width = (fixed 120)
          height = (fixed 36)
        button nextID "Next":
          width = (fixed 104)
          height = (fixed 36)
    table (id "media" "metadata-table"):
      width = fill
      height = fit
      alignItems = AlignStretch
      tableHeader (id "media" "metadata-header"):
        width = fill
        height = (fixed 34)
        alignItems = AlignCenter
        tableCell (id "media" "metadata-header-field"):
          width = (fixed 110)
          height = fill
          padding = 8
          label (id "media" "metadata-header-field-label") "Field":
            width = fill
            height = fit
        tableCell (id "media" "metadata-header-value"):
          width = fill
          height = fill
          padding = 8
          label (id "media" "metadata-header-value-label") "Value":
            width = fill
            height = fit
      mediaMetadataRow "media" "Status" displayStatus
      mediaMetadataRow "media" "Player" player
      mediaMetadataRow "media" "Album" album
      mediaMetadataRow "media" "Length" length
      mediaMetadataRow "media" "URL" url
