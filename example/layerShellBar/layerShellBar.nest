define:
  openButton (id)
  reloadButton (id)
  quitButton (id)
  defaultGap 6.0

events:
  when (clicked openButton):
    exec "printf 'nest layer shell open\n'"
  when (clicked reloadButton):
    exec "printf 'nest layer shell reload\n'"
  when (clicked quitButton):
    exec "printf 'quit button clicked\n'"

panel (id):
  width = (fill)
  height = (fill)
  padding = 5.0
  alignItems = AlignCenter
  justifyContent = JustifyCenter
  row (id):
    width = (fill)
    height = (fixed 24)
    gap = defaultGap
    alignItems = AlignCenter
    label (id) "Nest, a program":
      width = (fit)
      height = (fit)
    button openButton "Alatar":
      width = (fixed 66)
      height = (fixed 24)
    button reloadButton "Reload":
      width = (fixed 78)
      height = (fixed 24)
    spacer (id):
      width = (fill)
      height = (fixed 1)
    label (id) "Layer shell proof":
      width = (fixed 150)
      height = (fit)
    button quitButton "Quit":
      width = (fixed 58)
      height = (fixed 24)
