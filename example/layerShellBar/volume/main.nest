import "../components/volume.nest"
import "../../../lib/components/radioGroup.nest"

define:
  muteID = (id "volume" "mute")
  downID = (id "volume" "down")
  upID = (id "volume" "up")
  mixerID = (id "volume" "mixer")
  closeID = (id "volume" "close")
  sliderID = (id "volume" "slider")
  status = ""
  percent = 0
  draggedVolume = nothing
  defaultSink = ""
  sinks = list

set status (shell (volumeStatusCommand))
set percent (shell (volumePercentCommand))
set defaultSink (shell (volumeDefaultSinkCommand))
set sinks (textLines (shell (volumeSinkListCommand)))

events:
  when (keyPressed "escape"):
    closeDialog ""
  when (clicked muteID):
    shellAsync (id "volume" "action" "mute") (volumeActionCommand "toggle") 0
  when (clicked downID):
    shellAsync (id "volume" "action" "down") (volumeActionCommand "down") 0
  when (clicked upID):
    shellAsync (id "volume" "action" "up") (volumeActionCommand "up") 0
  when (clicked mixerID):
    shellAsync (id "volume" "action" "mixer") (volumeActionCommand "mixer") 0
  set draggedVolume (verticalSlider sliderID percent 0 150)
  when (not (= draggedVolume nothing)):
    set percent draggedVolume
    shellAsync (id "volume" "set") (volumeSetCommand draggedVolume) 0
  when (clicked closeID):
    closeDialog ""
  for sink (iter sinks):
    define:
      sourceID = (radioOptionID "volume-sources" sink)
    when (clicked sourceID):
      shell (volumeSinkSwitchCommand sink)
      set defaultSink sink

card (id "volume" "panel"):
  width = fill
  height = fill
  padding = 10
  gap = 8
  alignItems = AlignStretch
  dialogHeader (id "volume" "header"):
    width = fill
    height = fixed 32
    padding = 8
    alignItems = AlignCenter
    label (id "volume" "title") "Volume":
      width = fill
      height = fit
    button closeID "x":
      width = fixed 28
      height = fit
  row (id "volume" "body"):
    width = fill
    height = fill
    gap = 12
    alignItems = AlignCenter
    justifyContent = JustifyStart
    column (id "volume" "readout"):
      width = fill
      height = fill
      gap = 8
      alignItems = AlignStretch
      justifyContent = JustifyCenter
      label (id "volume" "status") (string "♫ " status):
        width = fill
        height = fit
      label (id "volume" "percent") (string percent "%"):
        width = fill
        height = fit
      row (id "volume" "actions"):
        width = fill
        height = fit
        gap = 8
        alignItems = AlignCenter
        justifyContent = JustifyCenter
        button downID "-":
          width = fixed 48
          height = fit
        button muteID "Mute":
          width = fixed 78
          height = fit
        button upID "+":
          width = fixed 48
          height = fit
      button mixerID "Open mixer":
        width = fill
        height = fit
      radioGroup "volume-sources" sinks defaultSink
    verticalSlider sliderID percent 0 150:
      width = fixed 46
      height = fill
