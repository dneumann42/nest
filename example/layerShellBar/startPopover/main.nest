define:
  commands = []:
    {}:
      label = "Packages"
      name = (id "menu" "packages")
      cmd = "shelly-ui"
      place = "left"
    {}:
      label = "Pick Wallpaper"
      name = (id "menu" "wallpaper")
      cmd = "~/.config/sway/scripts/wallpapers pick"
      place = "left"
    {}:
      label = "Monitor On/Off"
      name = (id "menu" "monitors")
      cmd = "foot /home/dneumann/.config/sway/scripts/monitors.sh pick"
      place = "left"
    {}:
      label = "Float Rules"
      name = (id "menu" "float-rules")
      cmd = "foot /home/dneumann/.config/sway/scripts/sway-float-rules"
      place = "left"
    {}:
      label = "Editor"
      name = (id "menu" "emacs")
      cmd = "emacsclient -c -a emacs"
      place = "right"
    {}:
      label = "Office"
      name = (id "menu" "libreoffice")
      cmd = "libreoffice"
      place = "right"
    {}:
      label = "Files"
      name = (id "menu" "files")
      cmd = "pcmanfm"
      place = "right"
    {}:
      label = "Maindo"
      name = (id "menu" "maindo")
      cmd = "wish ~/.projects/maindo_tcl/main.tcl"
      place = "right"
    {}:
      label = "Logout"
      name = (id "menu" "logout")
      cmd = "loginctl terminate-session"
      place = "bottom"
    {}:
      label = "Shutdown"
      name = (id "menu" "shutdown")
      cmd = "systemctl shutdown now"
      place = "bottom"
    {}:
      label = "Reboot"
      name = (id "menu" "reboot")
      cmd = "restart"
      place = "bottom"

events:
  when (keyPressed "escape"):
    closeDialog ""
  for command (iter commands):
    when (clicked command.name):
      shellLaunch command.cmd
      closeDialog command.name

card (id "menu" "panel"):
  width = fill
  height = fill
  padding = 32
  gap = 12
  alignItems = AlignStretch
  background = color 0 0 0
  opacity = 0.85
  image (id "menu" "banner") "example/layerShellBar/assets/nomicon.bmp":
    width = fixed 256
    height = fixed 70
    alignSelf = AlignCenter
  label (id "menu" "subtitle") "Applications and desktop controls":
    width = fit
    height = fit
    alignSelf = AlignCenter
  row (id "menu" "apps"):
    width = fill
    height = fill
    gap = 12
    alignItems = AlignStretch
    column (id "menu" "left"):
      width = fill
      height = fit
      gap = 8
      alignItems = AlignStretch
      for cmd (iter commands):
	when (= cmd.place "left"):
          button cmd.name cmd.label:
            width = fill
            height = fit
    column (id "menu" "right"):
      width = fill
      height = fit
      gap = 8
      alignItems = AlignStretch
      for cmd (iter commands):
	when (= cmd.place "right"):
          button cmd.name cmd.label:
            width = fill
            height = fit
  row (id "menu" "power"):
    width = fill
    height = fit
    gap = 8
    alignItems = AlignCenter
    justifyContent = JustifyCenter
    for cmd (iter commands):
      when (= cmd.place "bottom"):
        button cmd.name cmd.label:
          width = fixed 116
          height = fit
