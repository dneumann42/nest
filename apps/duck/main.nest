
use search:
  include textReplaceAllFrom textReplaceAll openFindDialog openReplaceDialog findFrom findNextWith findNext replaceCurrent replaceAll gotoLine timeDate

use menu:
  include handleMenuAction duckMenuBar

use dialogs:
  include labeledInput actionRow findDialog replaceDialog gotoDialog aboutDialog

use editorWorkspace:
  include leafPane splitPane firstPaneID paneCount paneEditorID paneBufferKey setPaneBuffer replaceBuffer splitLeaf unsplitLeaf editorTree editorWorkspace

use appShell:
  include duckStatusBar duckAppShell

define:
  rootID = id
  menuID = (id "duck" "menubar")
  tabBarID = (id "duck" "tabs")
  findInputID = (id "duck" "find" "input")
  replaceFindInputID = (id "duck" "replace" "find")
  replaceWithInputID = (id "duck" "replace" "with")
  gotoInputID = (id "duck" "goto" "line")
  findNextID = (id "duck" "find" "next")
  findCloseID = (id "duck" "find" "close")
  replaceNextID = (id "duck" "replace" "next")
  replaceOneID = (id "duck" "replace" "one")
  replaceAllID = (id "duck" "replace" "all")
  replaceCloseID = (id "duck" "replace" "close")
  gotoButtonID = (id "duck" "goto" "go")
  gotoCloseID = (id "duck" "goto" "close")
  aboutCloseID = (id "duck" "about" "close")
  menuAction = nothing
  pickedFile = ""
  statusText = "Ready"
  activeBuffer = 0
  nextBuffer = 2
  closingBufferKey = ""
  replacementBufferKey = ""
  showFind = false
  showReplace = false
  showGoto = false
  showAbout = false
  matchCase = false
  wordWrap = false
  showStatusBar = true
  showLineNumbers = false
  lastFindStart = -1
  lastFindStop = -1
  buffers = []:
    {}:
      key = "duck:buffer:1"
      path = ""
      name = "Untitled 1"
      savedText = ""

fun bufferKeyAt index:
  dict-get (nth buffers index) "key"

fun activeEditorID:
  bufferKeyAt activeBuffer

fun activeText:
  editorText (activeEditorID)

fun bufferDirtyAt index buffer:
  not (= (editorText buffer.key) buffer.savedText)

fun bufferTitle index buffer:
  if (bufferDirtyAt index buffer):
    string "*" buffer.name
  else:
    buffer.name

fun bufferLabels source:
  define:
    labels = list
    bufferIndex = 0
  for buffer (iter source):
    set labels (listAppend labels (bufferTitle bufferIndex buffer))
    += bufferIndex 1
  labels

fun bufferIndexForKey source key index:
  cond:
    when (empty? source):
      -1
    when (= (first source).key key):
      index
    when true:
      bufferIndexForKey (rest source) key (+ index 1)

fun bufferNameForKey key:
  define:
    foundIndex = (bufferIndexForKey buffers key 0)
  if (>= foundIndex 0):
    (nth buffers foundIndex).name
  else:
    "Closed buffer"

fun removeAt values index:
  if (empty? values):
    list
  else:
    if (= index 0):
      rest values
    else:
      cons (first values) (removeAt (rest values) (- index 1))

fun timeDateStamp:
  formatNow "h:mm tt M/d/yyyy"

fun clampActiveBuffer:
  when (empty? buffers):
    newBuffer
  when (>= activeBuffer (length buffers)):
    set activeBuffer (- (length buffers) 1)
  when (< activeBuffer 0):
    set activeBuffer 0

fun newBuffer:
  define:
    buffer = {}:
      key = (string "duck:buffer:" nextBuffer)
      path = ""
      name = (string "Untitled " nextBuffer)
      savedText = ""
  set buffers (listAppend buffers buffer)
  set activeBuffer (- (length buffers) 1)
  += nextBuffer 1
  send "duck.editor.switch-buffer" buffer.key
  clearEditor (activeEditorID)
  set statusText "New document"

fun openFileInEditor path:
  define:
    content = ""
    buffer = {}:
      key = (string "duck:buffer:" nextBuffer)
      path = path
      name = (pathBaseName path)
      savedText = ""
  with (open-file path "rb") stream:
    set content (read-all stream)
  set buffer.savedText content
  set buffers (listAppend buffers buffer)
  set activeBuffer (- (length buffers) 1)
  += nextBuffer 1
  send "duck.editor.switch-buffer" buffer.key
  setEditorText (activeEditorID) content
  set statusText (string "Opened " path)

fun saveActiveBufferAs path:
  define:
    content = (activeText)
  with (open-file path "wb") stream:
    write stream content
  set buffers.[activeBuffer].path path
  set buffers.[activeBuffer].name (pathBaseName path)
  set buffers.[activeBuffer].savedText content
  set statusText (string "Saved " path)

fun saveActiveBuffer:
  if (= buffers.[activeBuffer].path ""):
    pickFileEvent "duck:saveAsPicked"
  else:
    saveActiveBufferAs buffers.[activeBuffer].path

fun closeBufferAt index:
  if (> (length buffers) 1):
    define:
      closingKey = (bufferKeyAt index)
      fallbackIndex = (pick (= index 0) 1 0)
      fallbackKey = (bufferKeyAt fallbackIndex)
    set closingBufferKey closingKey
    set replacementBufferKey fallbackKey
    send "duck.editor.replace-buffer" true
    send "duck.editor.close-pane" true
    set buffers (removeAt buffers index)
    set activeBuffer (pick (>= index (length buffers)) (- (length buffers) 1) index)
    set statusText "Buffer closed"
  else:
    clearEditor (activeEditorID)
    set buffers.[0].path ""
    set buffers.[0].name "Untitled 1"
    set buffers.[0].savedText ""
    set activeBuffer 0
    set statusText "Last buffer cleared"

fun closeActiveBuffer:
  closeBufferAt activeBuffer

clampActiveBuffer

events:
  when (external "duck:filePicked"):
    set pickedFile (pickResult "duck:filePicked")
    openFileInEditor pickedFile
    set menuAction pickedFile
    clearPickResult "duck:filePicked"

  when (external "duck:saveAsPicked"):
    set pickedFile (pickResult "duck:saveAsPicked")
    saveActiveBufferAs pickedFile
    set menuAction pickedFile
    clearPickResult "duck:saveAsPicked"

  when (keyPressed "f3"):
    findNext
  when (keyPressed "f5"):
    timeDate
  when (keyPressed "escape"):
    set showFind false
    set showReplace false
    set showGoto false
    set showAbout false

  when (clicked findNextID):
    findNext
  when (submitted findInputID):
    findNext
  when (clicked findCloseID):
    set showFind false
  when (clicked (id "duck" "find" "match")):
    set matchCase (not matchCase)
  when (clicked replaceNextID):
    findNextWith (editorText replaceFindInputID)
  when (clicked replaceOneID):
    replaceCurrent
  when (clicked replaceAllID):
    replaceAll
  when (clicked replaceCloseID):
    set showReplace false
  when (clicked gotoButtonID):
    gotoLine
  when (submitted gotoInputID):
    gotoLine
  when (clicked gotoCloseID):
    set showGoto false
  when (clicked aboutCloseID):
    set showAbout false

  define:
    tabIndex = 0
  for buffer (iter buffers):
    when (clicked (id tabBarID "tab" tabIndex)):
      set activeBuffer tabIndex
      send "duck.editor.switch-buffer" buffer.key
    when (middleClicked (id tabBarID "tab" tabIndex)):
      closeBufferAt tabIndex
    += tabIndex 1

  when (not (= (menuResult "duck:menubar") nothing)):
    set menuAction (menuResult "duck:menubar")
    handleMenuAction menuAction
    clearMenuResult "duck:menubar"

duckAppShell
