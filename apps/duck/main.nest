define:
  rootID = id
  panelColor = color 100 100 100
  menuID = (id "duck" "menubar")
  editorID = (id "duck" "editor")
  menuAction = nothing
  pickedFile = ""

fun openFileInEditor path:
  with (open-file path "rb") stream:
    define:
      content = (read-all stream)
    setEditorText editorID content

events:
  when (external "duck:filePicked"):
    set pickedFile (pickResult "duck:filePicked")
    openFileInEditor pickedFile
    set menuAction pickedFile
    clearPickResult "duck:filePicked"

  when (not (= (menuResult "duck:menubar") nothing)):
    set menuAction (menuResult "duck:menubar")
    when (= menuAction "file.open"):
      pickFileEvent "duck:filePicked"
    when (= menuAction "file.save"):
      set menuAction (editorText editorID)
    clearMenuResult "duck:menubar"

fun duckMenuBar:
  menuBar menuID:
    width = fill
    height = fixed 24
    padding = 0
    background = panelColor
    alignItems = AlignStretch
    menu "file" "File":
      menuItem "new" "New"
      menuItem "open" "Open"
      menuItem "save" "Save"
      menuItem "saveas" "Save As"
      menuDivider
      menuItem "quit" "Quit"

panel rootID:
  width = fill
  height = fill
  gap = 0.0
  padding = 0.0
  alignItems = AlignStretch
  duckMenuBar
  editor editorID:
    width = fill
    height = fill
