define:
  rootID = id
  panelColor = color 100 100 100
  menuAction = nothing
  menuID = (id "duck" "menubar")

events:
  when (not (= (menuResult "duck:menubar") nothing)):
    set menuAction (menuResult "duck:menubar")
    clearMenuResult "duck:menubar"

fun duckMenuBar:
  menuBar menuID:
    width = fill
    height = fixed 24
    padding = 0
    background = panelColor
    alignItems = AlignStretch
    menu "file" "File":
      menuItem "new" "New"
      menuItem "open" "Open"
      menuItem "save" "Save"
      menuItem "saveas" "Save As"
      menuDivider
      menuItem "quit" "Quit"

panel rootID:
  width = fill
  height = fill
  gap = 12.0
  padding = 0.0
  alignItems = AlignStretch
  duckMenuBar
  label (id "duck" "title") "Duck":
    width = fit
    height = fit
    alignSelf = AlignCenter
  label (id "duck" "menu-action") menuAction:
    width = fit
    height = fit
    alignSelf = AlignCenter
