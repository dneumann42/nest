fun labeledInput rowID labelText inputID initialText:
  row rowID:
    width = fill
    height = fit
    gap = 8
    alignItems = AlignCenter
    label (id rowID "label") labelText:
      width = fixed 96
      height = fit
    lineInput inputID initialText:
      width = fill
      height = fixed 30

block-command actionRow rowID:
  row (eval rowID):
    width = fill
    height = fit
    gap = 8
    justifyContent = JustifyEnd
    eval block

fun findDialog:
  modalDialog (id "duck" "find" "dialog") showFind:
    width = fixed 420
    height = fit
    padding = 12
    gap = 10
    alignItems = AlignStretch
    background = color 30 30 30
    dialogHeader (id "duck" "find" "header"):
      width = fill
      height = fit
      padding = 6
      label (id "duck" "find" "title") "Find":
        width = fill
        height = fit
    labeledInput (id "duck" "find" "row") "Find what:" findInputID ""
    checkbox (id "duck" "find" "match") "Match case" matchCase:
      width = fit
      height = fit
    actionRow (id "duck" "find" "actions"):
      button findNextID "Find Next":
        width = fixed 100
        height = fit
      button findCloseID "Cancel":
        width = fixed 82
        height = fit

fun replaceDialog:
  modalDialog (id "duck" "replace" "dialog") showReplace:
    width = fixed 450
    height = fit
    padding = 12
    gap = 10
    alignItems = AlignStretch
    background = color 30 30 30
    dialogHeader (id "duck" "replace" "header"):
      width = fill
      height = fit
      padding = 6
      label (id "duck" "replace" "title") "Replace":
        width = fill
        height = fit
    labeledInput (id "duck" "replace" "findrow") "Find what:" replaceFindInputID ""
    labeledInput (id "duck" "replace" "withrow") "Replace with:" replaceWithInputID ""
    actionRow (id "duck" "replace" "actions"):
      button replaceNextID "Find Next":
        width = fixed 96
        height = fit
      button replaceOneID "Replace":
        width = fixed 88
        height = fit
      button replaceAllID "Replace All":
        width = fixed 110
        height = fit
      button replaceCloseID "Cancel":
        width = fixed 80
        height = fit

fun gotoDialog:
  modalDialog (id "duck" "goto" "dialog") showGoto:
    width = fixed 340
    height = fit
    padding = 12
    gap = 10
    alignItems = AlignStretch
    background = color 30 30 30
    dialogHeader (id "duck" "goto" "header"):
      width = fill
      height = fit
      padding = 6
      label (id "duck" "goto" "title") "Go To Line":
        width = fill
        height = fit
    labeledInput (id "duck" "goto" "row") "Line number:" gotoInputID "1"
    actionRow (id "duck" "goto" "actions"):
      button gotoButtonID "Go To":
        width = fixed 82
        height = fit
      button gotoCloseID "Cancel":
        width = fixed 82
        height = fit

fun aboutDialog:
  modalDialog (id "duck" "about" "dialog") showAbout:
    width = fixed 360
    height = fit
    padding = 0
    gap = 0
    alignItems = AlignStretch
    background = color 30 30 30
    dialogHeader (id "duck" "about" "header"):
      width = fill
      height = fit
      padding = 6
      label (id "duck" "about" "title") "About Duck":
        width = fill
        height = fit
    column (id):
      width = fill
      height = fill
      padding = 12
      gap = 20
      label (id "duck" "about" "body") "Duck Editor v0.0.0":
        width = fill
        height = fit
      label (id "duck" "about" "features") "Text editor written in owl using nest":
        width = fill
        height = fit
      actionRow (id "duck" "about" "actions"):
        button aboutCloseID "OK":
          width = fixed 82
          height = fit
