import "../variables.nest"
import "../components/volume.nest"
import "../../../lib/components/radioGroup.nest"

state "root":
  muteID = (id "volume" "mute")
  downID = (id "volume" "down")
  upID = (id "volume" "up")
  mixerID = (id "volume" "mixer")
  closeID = (id "volume" "close")
  sliderID = (id "volume" "slider")
  status = ""
  percent = 0
  draggedVolume = nothing
  defaultSink = ""
  sinks = list

set status (shell (volumeDialogStatusCommand))
set percent (shell (volumePercentCommand))
set defaultSink (shell (volumeDefaultSinkCommand))
set sinks (textLines (shell (volumeSinkListCommand)))

events:
  when (keyPressed "escape"):
    closeDialog ""
  when (clicked muteID):
    shellAsync (id "volume" "action" "mute") (volumeActionCommand "toggle") ImmediateInterval
  when (clicked downID):
    shellAsync (id "volume" "action" "down") (volumeActionCommand "down") ImmediateInterval
  when (clicked upID):
    shellAsync (id "volume" "action" "up") (volumeActionCommand "up") ImmediateInterval
  when (clicked mixerID):
    shellAsync (id "volume" "action" "mixer") (volumeActionCommand "mixer") ImmediateInterval
  set draggedVolume (verticalSlider sliderID percent 0 VolumeMax)
  when (not (= draggedVolume nothing)):
    set percent draggedVolume
    shellAsync (id "volume" "set") (volumeSetCommand draggedVolume) ImmediateInterval
  when (clicked closeID):
    closeDialog ""
  for sink (iter sinks):
    define:
      sourceID = (radioOptionID "volume-sources" sink)
    when (clicked sourceID):
      shell (volumeSinkSwitchCommand sink)
      set defaultSink sink

card (id "volume" "panel"):
  width = fill
  height = fill
  padding = DialogPadding
  gap = DialogGap
  alignItems = AlignStretch
  background = color 0 0 0
  opacity = DialogOpacity
  dialogHeader (id "volume" "header"):
    width = fill
    height = fixed DialogHeaderHeight
    padding = DialogHeaderPadding
    alignItems = AlignCenter
    label (id "volume" "title") "Volume":
      width = fill
      height = fit
    button closeID "x":
      width = fixed DialogCloseButtonWidth
      height = fit
  row (id "volume" "body"):
    width = fill
    height = fill
    gap = VolumeBodyGap
    alignItems = AlignCenter
    justifyContent = JustifyStart
    column (id "volume" "readout"):
      width = fill
      height = fill
      gap = DialogGap
      alignItems = AlignStretch
      justifyContent = JustifyCenter
      label (id "volume" "status") (string "♫ " status):
        width = fill
        height = fit
      label (id "volume" "percent") (string percent "%"):
        width = fill
        height = fit
      row (id "volume" "actions"):
        width = fill
        height = fit
        gap = DialogGap
        alignItems = AlignCenter
        justifyContent = JustifyCenter
        button downID "-":
          width = fixed VolumeSmallButtonWidth
          height = fit
        button muteID "Mute":
          width = fixed VolumeMuteButtonWidth
          height = fit
        button upID "+":
          width = fixed VolumeSmallButtonWidth
          height = fit
      button mixerID "Open mixer":
        width = fill
        height = fit
      radioGroup "volume-sources" sinks defaultSink
    verticalSlider sliderID percent 0 VolumeMax:
      width = fixed VolumeSliderWidth
      height = fill
