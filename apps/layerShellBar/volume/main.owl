import "../variables.owl"
import "../components/volume.owl"
import "../../../lib/components/radioGroup.owl"

state "root":
  muteID = (id "volume" "mute")
  downID = (id "volume" "down")
  upID = (id "volume" "up")
  mixerID = (id "volume" "mixer")
  closeID = (id "volume" "close")
  sliderID = (id "volume" "slider")
  status = ""
  percent = 0
  rawPercent = ""
  draggedVolume = nothing
  defaultSink = ""
  sinks = list

set status (shellAsync (id "volume" "query" "status") (volumeDialogStatusCommand) FastPollInterval)
set rawPercent (shellAsync (id "volume" "query" "percent") (volumePercentCommand) FastPollInterval)
set percent (pick (= rawPercent "") percent rawPercent)
set defaultSink (shellAsync (id "volume" "query" "default-sink") (volumeDefaultSinkCommand) StoragePollInterval)
set sinks (textLines (shellAsync (id "volume" "query" "sinks") (volumeSinkListCommand) StoragePollInterval))

events:
  when (keyPressed "escape"):
    requestCloseDialog ""
  when (clicked muteID):
    shellAsync (id "volume" "action" "mute") (volumeActionCommand "toggle") ImmediateInterval
  when (clicked downID):
    shellAsync (id "volume" "action" "down") (volumeActionCommand "down") ImmediateInterval
  when (clicked upID):
    shellAsync (id "volume" "action" "up") (volumeActionCommand "up") ImmediateInterval
  when (clicked mixerID):
    shellAsync (id "volume" "action" "mixer") (volumeActionCommand "mixer") ImmediateInterval
  set draggedVolume (verticalSlider sliderID percent 0 VolumeMax)
  when (not (= draggedVolume nothing)):
    set percent draggedVolume
    shellAsync (id "volume" "set") (volumeSetCommand draggedVolume) ImmediateInterval
  when (clicked closeID):
    requestCloseDialog ""
  for sink (iter sinks):
    define:
      sourceID = (radioOptionID "volume-sources" sink)
    when (clicked sourceID):
      shellAsync (id "volume" "action" "sink" sink) (volumeSinkSwitchCommand sink) ImmediateInterval
      set defaultSink sink

animation (id "volume" "panel") (not (dialogClosing?)):
  duration = DialogAnimationDuration
  curve = "backOut"
  fromOpacity = 0
  maxOpacity = 0.95
  fromScale = DialogAnimationFromScale
  offsetY = 6
  card (id "volume" "panel"):
    width = fill
    height = fill
    padding = DialogPadding
    gap = DialogGap
    alignItems = Stretch
    background = color 0 0 0
    opacity = 1
    dialogHeader (id "volume" "header"):
      width = fill
      height = fixed DialogHeaderHeight
      padding = DialogHeaderPadding
      alignItems = Center
      label (id "volume" "title") "Volume":
        width = fill
        height = fit
      button closeID "x":
        width = fixed DialogCloseButtonWidth
        height = fit
      tooltip closeID "Close"
    row (id "volume" "body"):
      width = fill
      height = fill
      gap = VolumeBodyGap
      alignItems = Center
      justifyContent = Start
      column (id "volume" "readout"):
        width = fill
        height = fill
        gap = DialogGap
        alignItems = Stretch
        justifyContent = Center
        label (id "volume" "status") (string "♫ " status):
          width = fill
          height = fit
        label (id "volume" "percent") (string percent "%"):
          width = fill
          height = fit
        row (id "volume" "actions"):
          width = fill
          height = fit
          gap = DialogGap
          alignItems = Center
          justifyContent = Center
          button downID "-":
            width = fixed VolumeSmallButtonWidth
            height = fit
          tooltip downID "Lower volume"
          button muteID "Mute":
            width = fixed VolumeMuteButtonWidth
            height = fit
          tooltip muteID "Toggle mute"
          button upID "+":
            width = fixed VolumeSmallButtonWidth
            height = fit
          tooltip upID "Raise volume"
        button mixerID "Open mixer":
          width = fill
          height = fit
        tooltip mixerID "Open mixer"
        radioGroup "volume-sources" sinks defaultSink
      verticalSlider sliderID percent 0 VolumeMax:
        width = fixed VolumeSliderWidth
        height = fill
      tooltip sliderID "Set volume"
