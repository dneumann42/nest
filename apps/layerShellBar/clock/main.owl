state "root":
  selectedDate = (today-date)
  clickedDate = nothing

import "../variables.owl"
import "../components/calendar.owl"

events:
  when (keyPressed "escape"):
    closeDialog ""
  when (not (= clickedDate nothing)):
    closeDialog clickedDate

card (id "start-popover"):
  width = fill
  height = fill
  padding = DialogPaddingWide
  gap = NoSpacing
  alignItems = AlignStretch
  background = color 0 0 0
  opacity = DialogOpacity
  dialogHeader (id "start-popover" "header"):
    width = fill
    height = (fixed DialogHeaderHeight)
    padding = DialogHeaderPadding
    alignItems = AlignCenter
    label (id "start-popover" "title") (clock "dddd, MMMM d"):
      width = fit
      height = fit
  column (id "start-popover" "actions"):
    width = fill
    height = fit
    padding = NoSpacing
    gap = NoSpacing
    alignItems = AlignStretch
    dateSelectorWithSignal "clock-calendar" selectedDate clickedDate
