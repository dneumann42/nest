import "../variables.owl"
import "../components/updates.owl"

state "root":
  closeID = (id "updates" "close")
  confirmID = (id "updates" "confirm")
  cancelID = (id "updates" "cancel")
  count = "?"

set count (shellAsync (id "updates" "count") (updateCountCommand) StoragePollInterval)

events:
  when (keyPressed "escape"):
    requestCloseDialog ""
  when (clicked closeID):
    requestCloseDialog ""
  when (clicked cancelID):
    requestCloseDialog ""
  when (clicked confirmID):
    requestCloseDialog "run-system-updates"

animation (id "updates" "panel") (not (dialogClosing?)):
  duration = DialogAnimationDuration
  curve = "backOut"
  fromOpacity = 0
  maxOpacity = 0.95
  fromScale = DialogAnimationFromScale
  offsetY = 6
  card (id "updates" "panel"):
    width = fill
    height = fill
    padding = DialogPadding
    gap = DialogGap
    alignItems = Stretch
    background = color 0 0 0
    opacity = 1
    dialogHeader (id "updates" "header"):
      width = fill
      height = fixed DialogHeaderHeight
      padding = DialogHeaderPadding
      alignItems = Center
      label (id "updates" "title") "System updates":
        width = fill
        height = fit
      button closeID "x":
        width = fixed DialogCloseButtonWidth
        height = fit
    label (id "updates" "prompt") (string count " package update(s) available. Run sudo pacman -Syu --noconfirm?"):
      width = fill
      height = fill
      textWrap = true
    row (id "updates" "actions"):
      width = fill
      height = fit
      gap = DialogGap
      button cancelID "No":
        width = fill
        height = fit
      button confirmID "Yes":
        width = fill
        height = fit
