import "variables.owl"

state "root":
  startID = id "start"
  clockID = id "clock"
  lastAction = ""

fun startMenu lbl:
  imageButton startID "apps/layerShellBar/assets/nomicon-small.bmp":
    width = fixed BarIconSize
    height = fixed BarIconSize
    background = theme-color "background"
    cornerStyle = "rounded"
    radius = BarWidgetRadius
    shadow = true
    shadowColor = BarWidgetShadowColor
    shadowOffsetX = BarWidgetShadowOffsetX
    shadowOffsetY = BarWidgetShadowOffsetY
    shadowBlur = BarWidgetShadowBlur
    shadowSpread = BarWidgetShadowSpread

  tooltip startID "Start"

fun dateTime:
  button clockID (string IconCalendar " " (clock "MMM d, yyyy   hh:mm:ss tt")):
    width = fit
    height = fixed BarWidgetHeight
    fontName = BarIconFontName
    fontSize = BarIconFontSize
    buttonPadding = BarWidgetPadding
    cornerStyle = "rounded"
    radius = BarWidgetRadius
    shadow = true
    shadowColor = BarWidgetShadowColor
    shadowOffsetX = BarWidgetShadowOffsetX
    shadowOffsetY = BarWidgetShadowOffsetY
    shadowBlur = BarWidgetShadowBlur
    shadowSpread = BarWidgetShadowSpread

  tooltip clockID "Calendar"

fun defaultConfig:
  {}:
    start-label = "Alatar"

fun wallpaperSwitcherCommand:
  "$HOME/.nimble/bin/nest run $HOME/.workspace/nest/apps/wallpaperSwitcher"

fun systemUpdateCommand:
  "ghostty --title='Pacman Update' -e bash -lc 'sudo pacman -Syu --noconfirm; status=$?; echo; echo Press-Enter-to-close; read -r; exit $status'"

state "root":
  cfg = defaultConfig

import "components/workspaces.owl"
import "components/activeWindow.owl"
import "components/volume.owl"
import "components/metrics.owl"
import "components/notifications.owl"
import "components/updates.owl"
import "components/tray.owl"

events:
  when (external "sigusr1"):
    toggleDialog
      "start"
      "./startPopover"
      dict-get cfg "start-label"
      startID
      (dialogAutoDismissOptions)

  when (and (clicked startID) (not (dialogOpen? "start"))):
    openDialog
      "start"
      "./startPopover"
      dict-get cfg "start-label"
      startID
      (dialogAutoDismissOptions)

  when (and (clicked clockID) (not (dialogOpen? "clock"))):
    openDialog "clock" "./clock" "" clockID (dialogAutoDismissOptions)

  when (not (= (dialogResult "start") nothing)):
    set lastAction (dialogResult "start")
    clearDialogResult "start"

  when (= lastAction "toggle-perf-overlay"):
    togglePerfOverlay
    set lastAction ""

  when (= lastAction "open-wallpaper-switcher"):
    shellLaunch (wallpaperSwitcherCommand)
    set lastAction ""

  when (= lastAction "run-system-updates"):
    shellLaunch (systemUpdateCommand)
    set lastAction ""

  when (= lastAction "logout"):
    shellLaunch "loginctl terminate-session"
    set lastAction ""

  when (= lastAction "shutdown"):
    shellLaunch "systemctl poweroff"
    set lastAction ""

  when (= lastAction "reboot"):
    shellLaunch "systemctl reboot"
    set lastAction ""

column (id "root"):
  width = fill
  height = fill
  alignItems = Stretch

  panel (id "bar"):
    width = fill
    height = fixed BarHeight
    padding = BarPadding
    alignItems = Stretch
    background = theme-color "panel"
    opacity = BarOpacity

    overlay (id "content"):
      width = fill
      height = fill
      alignItems = Center

      row (id "left"):
        width = fill
        height = fill
        gap = BarLeftGap
        alignItems = Center
        alignSelf = Stretch
        justifyContent = Start
        startMenu (dict-get cfg "start-label")
        workspaces "bar"
        activeWindow "bar"

      row (id "right"):
        width = fill
        height = fill
        gap = BarRightGap
        alignItems = Center
        justifyContent = End
        alignSelf = Stretch
        trayWidget "bar"
        volumeWidget "bar"
        notificationWidget "bar"
        updateWidget "bar"
        protonDriveSyncWidget "bar"
        cpuMeter "bar"
        memoryMeter "bar"
        storageMeter "bar"
        networkMeter "bar"

      row (id "clock-center"):
        width = fill
        height = fill
        alignItems = Center
        justifyContent = Center
        alignSelf = Stretch
        dateTime