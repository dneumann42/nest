import "variables.owl"

state "root":
  startID = (id "start")
  clockID = (id "clock")
  lastAction = ""

fun startMenu lbl:  
  imageButton startID "apps/layerShellBar/assets/nomicon-small.bmp":
    width = fixed BarIconSize
    height = fixed BarIconSize
    background = theme-color "background"
    cornerStyle = "rounded"
    radius = BarWidgetRadius
    shadow = true
    shadowColor = BarWidgetShadowColor
    shadowOffsetX = BarWidgetShadowOffsetX
    shadowOffsetY = BarWidgetShadowOffsetY
    shadowBlur = BarWidgetShadowBlur
    shadowSpread = BarWidgetShadowSpread
  tooltip startID "Start"

fun dateTime:
  button clockID (string IconCalendar " " (clock "MMM d, yyyy   hh:mm:ss tt")):
    width = fit
    height = fixed BarWidgetHeight
    fontName = BarIconFontName
    fontSize = BarIconFontSize
    buttonPadding = BarWidgetPadding
    cornerStyle = "rounded"
    radius = BarWidgetRadius
    shadow = true
    shadowColor = BarWidgetShadowColor
    shadowOffsetX = BarWidgetShadowOffsetX
    shadowOffsetY = BarWidgetShadowOffsetY
    shadowBlur = BarWidgetShadowBlur
    shadowSpread = BarWidgetShadowSpread
  tooltip clockID "Calendar"

fun defaultConfig:
  {}:
    start-label = "Alatar"

state "root":
  cfg = defaultConfig

import "components/workspaces.owl"
import "components/activeWindow.owl"
import "components/volume.owl"
import "components/metrics.owl"
import "components/notifications.owl"
import "mediaWidget.owl"

events:
  when (external "sigusr1"):
    toggleDialog "start" "./startPopover" (dict-get cfg "start-label") startID
  when (and (clicked startID) (not (dialogOpen? "start"))):
    openDialog "start" "./startPopover" (dict-get cfg "start-label") startID
  when (and (clicked clockID) (not (dialogOpen? "clock"))):
    openDialog "clock" "./clock" "" clockID
  when (not (= (dialogResult "start") nothing)):
    set lastAction (dialogResult "start")
    clearDialogResult "start"
  when (= lastAction "toggle-perf-overlay"):
    togglePerfOverlay
    set lastAction ""
  when (= lastAction "logout"):
    closeDialog "logout"

column (id "root"):
  width = fill
  height = fill
  alignItems = AlignStretch
  
  panel (id "bar"):
    width = fill
    height = fixed BarHeight
    padding = BarPadding
    alignItems = AlignStretch
    background = theme-color "panel"
    opacity = BarOpacity
    
    overlay (id "content"):
      width = fill
      height = fill
      alignItems = AlignCenter
    
      row (id "left"):
        width = fill
        height = fill
        gap = BarLeftGap
        alignItems = AlignCenter
        alignSelf = AlignStretch
        justifyContent = JustifyStart

        startMenu (dict-get cfg "start-label")
        workspaces "bar"
        activeWindow "bar"
      
      row (id "right"):
        width = fill
        height = fill
        gap = BarRightGap
        alignItems = AlignCenter
        justifyContent = JustifyEnd
        alignSelf = AlignStretch

        volumeWidget "bar"
        mediaWidget "bar-media"
        notificationWidget "bar"
        cpuMeter "bar"
        memoryMeter "bar"
        storageMeter "bar"
        networkMeter "bar"

      row (id "clock-center"):
        width = fill
        height = fill
        alignItems = AlignCenter
        justifyContent = JustifyCenter
        alignSelf = AlignStretch

        dateTime
