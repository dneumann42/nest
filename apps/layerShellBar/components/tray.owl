import "../variables.owl"

state "tray":
  menuTarget = ""
  menuData = ""

widget trayWidget key:
  define:
    keyText = (eval key)
    items = (trayItems)

  set menuData (trayMenuData menuTarget)

  events:
    when (not (= (dialogResult "tray-menu") nothing)):
      trayMenuActivate menuTarget (dialogResult "tray-menu")
      clearDialogResult "tray-menu"
      set menuTarget ""
      set menuData ""

  row (id keyText "tray"):
    width = fit
    height = fixed BarWidgetHeight
    gap = WorkspaceGap
    alignItems = Center
    if (empty? items):
      label (id keyText "tray-empty") "":
        width = (fixed 0)
        height = fixed BarWidgetHeight
    else:
      for item (iter items):
        define:
          itemID = (id keyText "item" (dict-get item "id"))
          iconPath = (dict-get item "iconPath")
          iconPresent = (dict-get item "hasIcon")
          itemTitle = (dict-get item "title")
          attention = (dict-get item "needsAttention")

        events:
          when (clicked itemID):
            trayActivate (string (dict-get item "id"))
          when (middleClicked itemID):
            traySecondaryActivate (string (dict-get item "id"))
          when (rightClicked itemID):
            set menuTarget (string (dict-get item "id"))
            set menuData ""
            trayRequestMenu (string (dict-get item "id"))
          when (and (= menuTarget (string (dict-get item "id"))) (not (= menuData "")) (not (dialogOpen? "tray-menu"))):
            openDialog "tray-menu" "./trayMenu" menuData itemID (dialogAutoDismissOptions)

        if iconPresent:
          imageButton itemID (string iconPath):
            width = fixed BarIconSize
            height = fixed BarIconSize
            background = (pick attention (color 118 70 20) (color 0 0 0 0))
            cornerStyle = "rounded"
            radius = BarWidgetRadius
            shadow = attention
            shadowColor = BarWidgetShadowColor
            shadowOffsetX = BarWidgetShadowOffsetX
            shadowOffsetY = BarWidgetShadowOffsetY
            shadowBlur = BarWidgetShadowBlur
            shadowSpread = BarWidgetShadowSpread
        else:
          button itemID (string "" " "):
            width = fit
            height = fixed BarWidgetHeight
            fontName = BarIconFontName
            fontSize = BarIconFontSize
            buttonPadding = BarWidgetPadding
            background = (pick attention (color 118 70 20) (color 20 20 20))
            cornerStyle = "rounded"
            radius = BarWidgetRadius
            shadow = attention
            shadowColor = BarWidgetShadowColor
            shadowOffsetX = BarWidgetShadowOffsetX
            shadowOffsetY = BarWidgetShadowOffsetY
            shadowBlur = BarWidgetShadowBlur
            shadowSpread = BarWidgetShadowSpread
        tooltip itemID itemTitle
