widget storageMeter key:
  define:
    storageID = (id (eval key) "storage")
  button storageID (string IconDisk " " (shellAsync (id (eval key) "storage-query") (storageCommand) StoragePollInterval)):
    width = fixed MetricStorageWidth
    height = fixed BarWidgetHeight
