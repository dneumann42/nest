widget networkMeter key:
  define:
    keyText = (eval key)
    buttonID = (id keyText "network")
    status = (shellAsync (id keyText "network-query") (networkCommand keyText) FastPollInterval)

  events:
    when (and (clicked buttonID) (not (dialogOpen? "network"))):
      openDialog "network" "./network" "" buttonID (dialogAutoDismissOptions)

  button buttonID (string IconNetwork " " status):
    width = fixed MetricNetworkWidth
    height = fixed BarWidgetHeight
    background = tint "sky"
    textScroll = true
    fontName = BarIconFontName
    fontSize = BarIconFontSize
    buttonPadding = BarWidgetPadding
    cornerStyle = "rounded"
    radius = BarWidgetRadius
    shadow = true
    shadowColor = BarWidgetShadowColor
    shadowOffsetX = BarWidgetShadowOffsetX
    shadowOffsetY = BarWidgetShadowOffsetY
    shadowBlur = BarWidgetShadowBlur
    shadowSpread = BarWidgetShadowSpread
  tooltip buttonID "Network throughput"
