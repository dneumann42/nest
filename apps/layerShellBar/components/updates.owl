import "../variables.owl"

fun updateCountCommand:
  string "state=${XDG_STATE_HOME:-$HOME/.local/state}/alatar/pacman-updates.count; if [ -r \"$state\" ]; then cat \"$state\"; else printf '?'; fi"

widget updateWidget key:
  define:
    keyText = (eval key)
    buttonID = (id keyText "updates")
    count = (shellAsync (id keyText "update-count") (updateCountCommand) StoragePollInterval)

  events:
    when (and (clicked buttonID) (not (dialogOpen? "updates"))):
      openDialog "updates" "./updates" "" buttonID (dialogAutoDismissOptions)

  button buttonID (string IconUpdates " " count):
    width = fit
    height = fixed BarWidgetHeight
    textScroll = true
    fontName = BarIconFontName
    fontSize = BarIconFontSize
    buttonPadding = BarWidgetPadding
    cornerStyle = "rounded"
    radius = BarWidgetRadius
    shadow = true
    shadowColor = BarWidgetShadowColor
    shadowOffsetX = BarWidgetShadowOffsetX
    shadowOffsetY = BarWidgetShadowOffsetY
    shadowBlur = BarWidgetShadowBlur
    shadowSpread = BarWidgetShadowSpread
  tooltip buttonID "System updates"

fun protonDriveSyncCommand:
  string "ghostty --title='Proton Drive Sync' -e bash -lc 'exec $HOME/.alatar/bin/proton-drive-sync'"

widget protonDriveSyncWidget key:
  define:
    keyText = (eval key)
    buttonID = (id keyText "proton-drive-sync")

  events:
    when (clicked buttonID):
      shellLaunch (protonDriveSyncCommand)

  button buttonID IconProtonDrive:
    width = fit
    height = fixed BarWidgetHeight
    fontName = BarIconFontName
    fontSize = BarIconFontSize
    buttonPadding = BarWidgetPadding
    cornerStyle = "rounded"
    radius = BarWidgetRadius
    shadow = true
    shadowColor = BarWidgetShadowColor
    shadowOffsetX = BarWidgetShadowOffsetX
    shadowOffsetY = BarWidgetShadowOffsetY
    shadowBlur = BarWidgetShadowBlur
    shadowSpread = BarWidgetShadowSpread
  tooltip buttonID "Proton Drive Sync"
