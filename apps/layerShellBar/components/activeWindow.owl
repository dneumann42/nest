import "../variables.owl"

component activeWindow key:
  define:
    keyText = (eval key)
    title = (swayActiveWindowSubscription (id keyText "active-window-query"))

  if (= title ""):
    label (id keyText "active-window") " ":
      width = fixed ActiveWindowWidth
      height = fit
      textScroll = true
      fontSize = BarWidgetFontSize
  else:
    label (id keyText "active-window") title:
      width = fixed ActiveWindowWidth
      height = fit
      textScroll = true
      fontSize = BarWidgetFontSize
