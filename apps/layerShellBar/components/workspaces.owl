import "../variables.owl"

fun workspaceLabel workspace:
  define:
    name = (dict-get workspace "name")
  cond:
    when (dict-get workspace "urgent"):
      string "! " IconWorkspace " " name
    when (dict-get workspace "focused"):
      string IconWorkspace " " name
    when T:
      string IconWorkspace " " name

fun workspaceBackgroundColor workspace:      
  cond:
    when (dict-get workspace "urgent"):
      (color 118 70 20)
    when (dict-get workspace "focused"):
      mix-color (theme-color "primary") (color 18 20 20) 0.4
    when T:
      (color 20 20 20)

fun workspaceQuery key:
  swayWorkspaceSubscription key

widget workspaces key:
  define:
    keyText = (eval key)
    workspaceList = (workspaceQuery (id keyText "query"))

  row (id keyText "workspaces"):
    width = fit
    height = fixed BarWidgetHeight
    gap = WorkspaceGap
    alignItems = AlignCenter
    if (empty? workspaceList):
      label (id keyText "empty") "-":
        width = (fixed WorkspaceEmptyWidth)
        height = fixed BarWidgetHeight
        fontSize = BarWidgetFontSize
    else:
      define:
        firstWorkspaceName = (dict-get (nth workspaceList 0) "name")
        lastWorkspaceName = (dict-get (nth workspaceList (- (length workspaceList) 1)) "name")
      for workspace (iter workspaceList):
        define:
          name = (dict-get workspace "name")
          workspaceID = (id keyText "workspace" name)
          firstWorkspace = (= name firstWorkspaceName)
          lastWorkspace = (= name lastWorkspaceName)
        events:
          when (clicked workspaceID):
            shellAsync (id keyText "activate" name) (swayWorkspaceCommand name) ImmediateInterval
        button workspaceID (workspaceLabel workspace):
          width = fit
          height = fixed BarWidgetHeight
          fontName = BarIconFontName
          fontSize = BarIconFontSize
          buttonPadding = BarWidgetPadding
          background = (workspaceBackgroundColor workspace)
          cornerStyle = "rounded"
          radiusTopLeft = (pick firstWorkspace BarWidgetRadius 0)
          radiusBottomLeft = (pick firstWorkspace BarWidgetRadius 0)
          radiusTopRight = (pick lastWorkspace BarWidgetRadius 0)
          radiusBottomRight = (pick lastWorkspace BarWidgetRadius 0)
          shadow = (or firstWorkspace lastWorkspace)
          shadowColor = BarWidgetShadowColor
          shadowOffsetX = BarWidgetShadowOffsetX
          shadowOffsetY = BarWidgetShadowOffsetY
          shadowBlur = BarWidgetShadowBlur
          shadowSpread = BarWidgetShadowSpread
        tooltip workspaceID (string "Workspace " name)
