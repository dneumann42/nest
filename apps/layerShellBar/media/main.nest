import "../variables.nest"
import "../components/media.nest"

define:
  artworkID = (id "media" "artwork")
  previousID = (id "media" "previous")
  playPauseID = (id "media" "play-pause")
  nextID = (id "media" "next")
  closeID = (id "media" "close")
  seekID = (id "media" "seek")
  title = ""
  artist = ""
  album = ""
  status = ""
  statusOverride = ""
  displayStatus = ""
  player = ""
  length = ""
  position = 0
  lengthSeconds = 0
  seekValue = nothing
  url = ""
  art = ""
  playPauseLabel = "Play"

set title (mediaCachedQuery (id "media" "query" "title") "popover-title" "metadata --format '{{title}}' 2>/dev/null" "No media")
set artist (mediaCachedQuery (id "media" "query" "artist") "popover-artist" "metadata --format '{{artist}}' 2>/dev/null" "")
set album (mediaCachedQuery (id "media" "query" "album") "popover-album" "metadata --format '{{album}}' 2>/dev/null" "")
set status (mediaCachedQuery (id "media" "query" "status") "popover-status" "status 2>/dev/null" "Stopped")
set player (mediaCachedQuery (id "media" "query" "player") "popover-player" "metadata --format '{{playerName}}' 2>/dev/null" "")
set length (mediaCachedQuery (id "media" "query" "length") "popover-length" "metadata --format '{{mpris:length}}' 2>/dev/null" "")
set lengthSeconds (mediaLengthSeconds (id "media" "query" "length-seconds"))
set position (mediaPositionSeconds (id "media" "query" "position"))
set url (mediaCachedQuery (id "media" "query" "url") "popover-url" "metadata --format '{{xesam:url}}' 2>/dev/null" "")
set art (mediaArtwork (id "media" "query" "art"))
when (= status statusOverride):
  set statusOverride ""
set displayStatus (pick (= statusOverride "") status statusOverride)
set playPauseLabel (pick (= displayStatus "Playing") "Pause" "Play")

redrawAfter MediaPollInterval

events:
  when (keyPressed "escape"):
    closeDialog ""
  when (clicked artworkID):
    closeDialog ""
  when (clicked closeID):
    closeDialog ""
  when (clicked previousID):
    mediaAction (id "media" "action" "previous") "previous 2>/dev/null"
  when (clicked playPauseID):
    set statusOverride (pick (= displayStatus "Playing") "Paused" "Playing")
    set displayStatus statusOverride
    set playPauseLabel (pick (= displayStatus "Playing") "Pause" "Play")
    mediaAction (id "media" "action" "play-pause") "play-pause 2>/dev/null"
  when (clicked nextID):
    mediaAction (id "media" "action" "next") "next 2>/dev/null"
  set seekValue (horizontalSlider seekID position 0 lengthSeconds)
  when (not (= seekValue nothing)):
    set position seekValue
    shellAsync (id "media" "action" "seek") (mediaSeekCommand seekValue) ImmediateInterval

card (id "media" "dialog"):
  width = fill
  height = fill
  padding = DialogPaddingWide
  gap = DialogSectionGap
  alignItems = AlignStretch
  background = theme-color "panel"
  opacity = DialogPanelOpacity
  dialogHeader (id "media" "header"):
    width = fill
    height = fixed DialogHeaderHeightTall
    padding = DialogHeaderPadding
    alignItems = AlignCenter
    label (id "media" "heading") "Now Playing":
      width = fill
      height = fit
    button closeID "x":
      width = fixed DialogCloseButtonWidthLarge
      height = fit
  row (id "media" "body"):
    width = fill
    height = fill
    gap = DialogPaddingWide
    alignItems = AlignStretch
    column (id "media" "left"):
      width = (fixed MediaPopoverLeftWidth)
      height = fill
      gap = DialogSectionGap
      alignItems = AlignStretch
      imageButton artworkID art:
        width = fill
        height = (fixed MediaPopoverArtworkHeight)
      row (id "media" "controls"):
        width = fill
        height = fit
        gap = MediaControlGap
        justifyContent = JustifyCenter
        button previousID "Prev":
          width = (fixed MediaControlButtonWidth)
          height = (fixed MediaControlHeight)
        button playPauseID playPauseLabel:
          width = (fixed MediaPlayButtonWidth)
          height = (fixed MediaControlHeight)
        button nextID "Next":
          width = (fixed MediaControlButtonWidth)
          height = (fixed MediaControlHeight)
      horizontalSlider seekID position 0 lengthSeconds:
        width = fill
        height = (fixed MediaSeekHeight)
    column (id "media" "details"):
      width = fill
      height = fill
      gap = MediaDetailsGap
      alignItems = AlignStretch
      label (id "media" "title") title:
        width = fill
        height = fit
        textScroll = true
      label (id "media" "artist") artist:
        width = fill
        height = fit
        textScroll = true
      label (id "media" "album") album:
        width = fill
        height = fit
        textScroll = true
      table (id "media" "metadata-table"):
        width = fill
        height = fit
        alignItems = AlignCenter
        tableHeader (id "media" "metadata-header"):
          width = fill
          height = (fixed MediaMetadataRowHeight)
          alignItems = AlignCenter
          tableCell (id "media" "metadata-header-field"):
            width = (fixed MediaMetadataLabelWidth)
            height = fill
            padding = MediaMetadataPadding
            label (id "media" "metadata-header-field-label") "Field":
              width = fill
              height = fit
          tableCell (id "media" "metadata-header-value"):
            width = fill
            height = fill
            padding = MediaMetadataPadding
            label (id "media" "metadata-header-value-label") "Value":
              width = fill
              height = fit
        mediaMetadataRow "media" "Status" displayStatus
        mediaMetadataRow "media" "Player" player
        mediaMetadataRow "media" "Length" length
        mediaMetadataRow "media" "URL" url
