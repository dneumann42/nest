import "../variables.owl"

state "root":
  commands = []:
    {}:
      label = "Packages"
      name = (id "menu" "packages")
      cmd = "shelly-ui"
      place = "left"
    {}:
      label = "Wallpaper"
      name = (id "menu" "wallpaper")
      cmd = "$HOME/.nimble/bin/nest run $HOME/.workspace/nest/apps/wallpaperSwitcher"
      place = "left"
    {}:
      label = "Monitor On/Off"
      name = (id "menu" "monitors")
      cmd = "foot /home/dneumann/.config/sway/scripts/monitors.sh pick"
      place = "left"
    {}:
      label = "Float Rules"
      name = (id "menu" "float-rules")
      cmd = "foot /home/dneumann/.config/sway/scripts/sway-float-rules"
      place = "left"
    {}:
      label = "Editor"
      name = (id "menu" "editor")
      cmd = "$HOME/.nimble/bin/nest run $HOME/.workspace/nest/apps/duck"
      place = "right"
    {}:
      label = "Office"
      name = (id "menu" "libreoffice")
      cmd = "libreoffice"
      place = "right"
    {}:
      label = "Files"
      name = (id "menu" "files")
      cmd = "pcmanfm"
      place = "right"
    {}:
      label = "Maindo"
      name = (id "menu" "maindo")
      cmd = "wish ~/.projects/maindo_tcl/main.tcl"
      place = "right"
    {}:
      label = "Library"
      name = (id "menu" "library")
      cmd = "pcmanfm $HOME/Documents/Library"
      place = "left"
    {}:
      label = "Perf Overlay"
      name = (id "menu" "perf-overlay")
      cmd = "toggle-perf-overlay"
      place = "right"
    {}:
      label = "Btop"
      name = (id "menu" "btop")
      cmd = "foot btop"
      place = "middle"
    {}:
      label = "Logout"
      name = (id "menu" "logout")
      cmd = "loginctl terminate-session"
      place = "bottom"

    {}:
      label = "Shutdown"
      name = (id "menu" "shutdown")
      cmd = "systemctl shutdown now"
      place = "bottom"
    {}:
      label = "Reboot"
      name = (id "menu" "reboot")
      cmd = "restart"
      place = "bottom"

events:
  when (keyPressed "escape"):
    closeDialog ""
  for command (iter commands):
    when (clicked command.name):
      if (= command.cmd "toggle-perf-overlay"):
        closeDialog command.cmd
      else:
        shellLaunch command.cmd
        closeDialog command.name

card (id "menu" "panel"):
  width = fill
  height = fill
  padding = StartMenuPadding
  gap = DialogSectionGap
  alignItems = AlignStretch
  background = color 0 0 0
  opacity = DialogStrongOpacity
  image (id "menu" "banner") "apps/layerShellBar/assets/nomicon.bmp":
    width = fixed StartMenuBannerWidth
    height = fixed StartMenuBannerHeight
    alignSelf = AlignCenter
  label (id "menu" "subtitle") "Launch application":
    width = fit
    height = fit
    alignSelf = AlignCenter
  row (id "menu" "apps"):
    width = fill
    height = fill
    gap = DialogSectionGap
    alignItems = AlignStretch
    column (id "menu" "left"):
      width = fill
      height = fit
      gap = DialogGap
      alignItems = AlignStretch
      for cmd (iter commands):
        when (= cmd.place "left"):
          button cmd.name cmd.label:
            width = fill
            height = fit
          tooltip cmd.name cmd.label
    column (id "menu" "right"):
      width = fill
      height = fit
      gap = DialogGap
      alignItems = AlignStretch
      for cmd (iter commands):
        when (= cmd.place "right"):
          button cmd.name cmd.label:
            width = fill
            height = fit
          tooltip cmd.name cmd.label
  column (id "menu" "middle"):
    width = fill
    height = fit
    gap = DialogGap
    alignItems = AlignCenter
    justifyContent = JustifyCenter
    for cmd (iter commands):
      when (= cmd.place "middle"):
        button cmd.name cmd.label:
          width = fill
          height = fit
        tooltip cmd.name cmd.label
  row (id "menu" "bottom"):
    width = fill
    height = fit
    gap = DialogGap
    alignItems = AlignCenter
    justifyContent = JustifyCenter
    for cmd (iter commands):
      when (= cmd.place "bottom"):
        button cmd.name cmd.label:
          width = fixed StartMenuPowerButtonWidth
          height = fit
        tooltip cmd.name cmd.label
