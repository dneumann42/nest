import "../variables.owl"

state "root":
  commands = []:
    {}:
      label = "Packages"
      name = (id "menu" "packages")
      cmd = "shelly-ui"
      place = "left"
    {}:
      label = "Alatar"
      name = (id "menu" "alatar")
      cmd = "ghostty --title='Alatar' -e bash -lc 'exec $HOME/.alatar/bin/alatar'"
      place = "left"
    {}:
      label = "Wallpaper"
      name = (id "menu" "wallpaper")
      cmd = "open-wallpaper-switcher"
      place = "left"
    {}:
      label = "Monitor On/Off"
      name = (id "menu" "monitors")
      cmd = "foot /home/dneumann/.config/sway/scripts/monitors.sh pick"
      place = "left"
    {}:
      label = "Monitor Mode"
      name = (id "menu" "recording-resolution")
      cmd = "/home/dneumann/.alatar/bin/toggle-main-monitor-resolution"
      place = "left"
    {}:
      label = "Float Rules"
      name = (id "menu" "float-rules")
      cmd = "foot /home/dneumann/.config/sway/scripts/sway-float-rules"
      place = "left"
    {}:
      label = "Editor"
      name = (id "menu" "editor")
      cmd = "$HOME/.nimble/bin/nest run $HOME/.workspace/nest/apps/duck"
      place = "right"
    {}:
      label = "Office"
      name = (id "menu" "libreoffice")
      cmd = "libreoffice"
      place = "right"
    {}:
      label = "Files"
      name = (id "menu" "files")
      cmd = "pcmanfm-qt"
      place = "right"
    {}:
      label = "Music"
      name = (id "menu" "music")
      cmd = "ghostty -e ncmpcpp"
      place = "right"
    {}:
      label = "Maindo"
      name = (id "menu" "maindo")
      cmd = "wish ~/.projects/maindo_tcl/main.tcl"
      place = "right"
    {}:
      label = "Library"
      name = (id "menu" "library")
      cmd = "pcmanfm $HOME/Documents/Library"
      place = "left"
    {}:
      label = "Perf Overlay"
      name = (id "menu" "perf-overlay")
      cmd = "toggle-perf-overlay"
      place = "right"
    {}:
      label = "Btop"
      name = (id "menu" "btop")
      cmd = "foot btop"
      place = "middle"
    {}:
      label = "Logout"
      name = (id "menu" "logout")
      cmd = "logout"
      place = "bottom"

    {}:
      label = "Shutdown"
      name = (id "menu" "shutdown")
      cmd = "shutdown"
      place = "bottom"
    {}:
      label = "Reboot"
      name = (id "menu" "reboot")
      cmd = "reboot"
      place = "bottom"

  opencodeInputID = (id "opencode" "input")
  opencodeSubmitID = (id "opencode" "submit")
  opencodePrompt = ""
  opencodeResponse = ""
  opencodeQueryKey = 0
  opencodeInputFocused = false

fun opencodeQueryCommand message:
  string "NO_COLOR=1 opencode run -m opencode/big-pickle -- " (shellQuote message) " 2>/dev/null"

events:
  when (keyPressed "escape"):
    requestCloseDialog ""
  when (not opencodeInputFocused):
    set opencodeInputFocused true
    focus opencodeInputID
  when (or (clicked opencodeSubmitID) (submitted opencodeInputID)):
    define:
      query = (editorText opencodeInputID)
    when (not (= query "")):
      setDialogPinned true
      set opencodePrompt query
      += opencodeQueryKey 1
      set opencodeResponse ""
  for command (iter commands):
    when (clicked command.name):
      if (or (= command.cmd "toggle-perf-overlay") (= command.cmd "open-wallpaper-switcher") (= command.cmd "logout") (= command.cmd "shutdown") (= command.cmd "reboot")):
        requestCloseDialog command.cmd
      else:
        shellLaunch command.cmd
        requestCloseDialog command.name

when (not (= opencodePrompt "")):
  set opencodeResponse (shellOnce (id "opencode" "query" opencodeQueryKey) (opencodeQueryCommand opencodePrompt))

animation (id "menu" "panel") (not (dialogClosing?)):
  duration = DialogAnimationDuration
  curve = "backOut"
  fromOpacity = 0
  maxOpacity = 0.95
  fromScale = DialogAnimationFromScale
  offsetY = 6
  card (id "menu" "panel"):
    width = fill
    height = fill
    padding = StartMenuPadding
    gap = DialogSectionGap
    alignItems = Stretch
    background = color 0 0 0
    opacity = 1
    padding = 64
    image (id "menu" "banner") "apps/layerShellBar/assets/nomicon.bmp":
      width = fixed StartMenuBannerWidth
      height = fixed StartMenuBannerHeight
      alignSelf = Center
    label (id "menu" "subtitle") "Launch application":
      width = fit
      height = fit
      alignSelf = Center
    row (id "menu" "apps"):
      width = fill
      height = fill
      gap = DialogSectionGap
      alignItems = Stretch
      column (id "menu" "left"):
        width = fill
        height = fit
        gap = DialogGap
        alignItems = Stretch
        for cmd (iter commands):
          when (= cmd.place "left"):
            button cmd.name cmd.label:
              width = fill
              height = fit
            tooltip cmd.name cmd.label
      column (id "menu" "right"):
        width = fill
        height = fit
        gap = DialogGap
        alignItems = Stretch
        for cmd (iter commands):
          when (= cmd.place "right"):
            button cmd.name cmd.label:
              width = fill
              height = fit
            tooltip cmd.name cmd.label
      column (id "opencode" "column"):
        width = fill
        height = fill
        gap = DialogSectionGap
        alignItems = Stretch
        label (id "opencode" "title") "OpenCode":
          width = fill
          height = fit
        row (id "opencode" "input-row"):
          width = fill
          height = fit
          gap = DialogGap
          alignItems = Center
          lineInput opencodeInputID "":
            width = fill
            height = fixed NetworkInputHeight
          button opencodeSubmitID "Send":
            width = fit
            height = fit
          tooltip opencodeSubmitID "Ask OpenCode"
        column (id "opencode" "response-scroll"):
          width = fill
          height = fill
          scrollY = true
          label (id "opencode" "response") (pick (= opencodeResponse "") (pick (= opencodePrompt "") "Type a message and press Send" "Thinking...") opencodeResponse):
            width = fill
            height = fixed 240
            textScroll = true
    column (id "menu" "middle"):
      width = fill
      height = fit
      gap = DialogGap
      alignItems = Center
      justifyContent = Center
      for cmd (iter commands):
        when (= cmd.place "middle"):
          button cmd.name cmd.label:
            width = fill
            height = fit
          tooltip cmd.name cmd.label
    row (id "menu" "bottom"):
      width = fill
      height = fit
      gap = DialogGap
      alignItems = Center
      justifyContent = Center
      for cmd (iter commands):
        when (= cmd.place "bottom"):
          button cmd.name cmd.label:
            width = fixed StartMenuPowerButtonWidth
            height = fit
          tooltip cmd.name cmd.label
